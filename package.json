{
  "name": "coastal-ads-command-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --watch server.js",
    "build": "vite build && node scripts/check-build.js",
    "postinstall": "npm run build",
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "db:migrate": "node scripts/migrate.js",
    "check": "node scripts/check-source.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mysql2": "^3.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.2.0",
    "luxon": "^3.7.2"
  }
}
